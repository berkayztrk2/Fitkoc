# FitKoç ortam değişkenleri
# Bu dosyayı .env olarak kopyalayıp kendi anahtarınızı girin: cp .env.example .env
#
# Google Gemini API anahtarı (öğün analizi, AI koç, tarif oluşturucu için).
# Ücretsiz anahtar: https://aistudio.google.com/app/apikey
# Not: EXPO_PUBLIC_ ön ekli değişkenler istemci paketine gömülür. Üretimde
# anahtarı doğrudan gömmek yerine bir backend proxy arkasına almanız önerilir.
EXPO_PUBLIC_GEMINI_API_KEY=
