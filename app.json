{
  "expo": {
    "name": "fitkoc-native",
    "slug": "fitkoc-native",
    "version": "1.0.0",
    "scheme": "fitkoc",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitkoc.app"
    },
    "android": {
      "package": "com.fitkoc.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-widgets",
        {
          "frequentUpdates": true,
          "widgets": [
            {
              "name": "WorkoutActivity",
              "displayName": "FitKoç Workout",
              "description": "Antrenman detaylarını gösterir.",
              "supportedFamilies": ["systemSmall"]
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95e0ed32-99ad-4557-aaa7-041c00a43a6e"
      }
    },
    "owner": "catters"
  }
}
