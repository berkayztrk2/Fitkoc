{
  "expo": {
    "name": "fitkoc-native",
    "slug": "fitkoc-native",
    "version": "1.0.0",
    "scheme": "fitkoc",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitkoc.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Yediğin yemeklerin fotoğrafını çekip AI ile kalori analizi yapabilmen için kameraya erişim gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Yemek fotoğrafı seçebilmen ve profil fotoğrafını ayarlayabilmen için galeriye erişim gerekiyor."
      }
    },
    "android": {
      "package": "com.fitkoc.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-widgets",
        {
          "frequentUpdates": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Yediğin yemeklerin fotoğrafını çekip AI ile kalori analizi yapabilmen için kameraya erişim gerekiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Yemek fotoğrafı seçebilmen ve profil fotoğrafını ayarlayabilmen için galeriye erişim gerekiyor."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B35"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95e0ed32-99ad-4557-aaa7-041c00a43a6e"
      }
    },
    "owner": "catters"
  }
}
